@model SlideViewModel

<section class="motivation-slide">
    <h1>Why Talk About DSLs?</h1>

    <div class="motivation-sources">
        <article class="motivation-card">
            <div class="motivation-label">THE BOOK</div>

            <h2>Crafting Interpreters</h2>
            <div class="motivation-byline">Robert Nystrom</div>

            <blockquote>
                “Crafting Interpreters contains everything you need to implement
                a full-featured, efficient scripting language...
                Your brain will light up with new ideas... It’s a blast.”
            </blockquote>
        </article>

        <article class="motivation-card">
            <div class="motivation-label">THE PROJECT</div>

            <h2>SchemaShift</h2>

            <p>
                A JSON-to-JSON mapping engine with a business-user-friendly DSL
                for transforming one document shape into another.
            </p>

            <p class="motivation-aside">
                Or at least that's the goal.
            </p>
        </article>
    </div>

    <div class="motivation-payoff">
        <div class="motivation-label">THE SURPRISE</div>

        <strong>They're not magic.</strong>

        <span>
            Building an interpreter can be surprisingly straightforward.
        </span>
    </div>
</section>