@model SlideViewModel

<section class="bullet-slide">
    <h1>Know Your Users</h1>

    <div class="row g-5 flex-grow-1 align-items-center">
        <div class="col-6">
            <ul class="slide-bullets">
                <li>
                    Who <strong>authors</strong> the language?
                </li>

                <li>
                    How technical are they?
                </li>

                <li>
                    What mistakes are they likely to make?
                </li>
            </ul>
        </div>

        <div class="col-6">
            <ul class="slide-bullets">
                <li>
                    Is the language read more often than written?
                </li>

                <li>
                    Is terse syntax actually valuable?
                </li>

                <li>
                    What should be <strong>impossible</strong> to express?
                </li>
            </ul>
        </div>
    </div>

    <div class="mt-4 p-3 rounded text-center bg-body-tertiary">
        <span class="fs-3">
            Optimize for the <strong>people using the language</strong>,
            not the people implementing it.
        </span>
    </div>
</section>