@model SlideViewModel

<section class="bullet-slide">
    <h1>Make the Grammar Boring</h1>

    <div class="bullet-content d-flex align-items-center">
        <ul class="slide-bullets">
            <li>
                Prefer <strong>familiar structure and delimiters</strong>.
            </li>

            <li>
                Make different constructs <strong>visually distinct</strong>.
            </li>

            <li>
                Avoid ambiguity.
            </li>

            <li>
                Prefer tokens that don't require
                <strong>parser context</strong> to recognize.
            </li>

            <li>
                Define <strong>precedence and associativity</strong>
                deliberately.
            </li>

            <li>
                Make invalid input <strong>fail predictably</strong>.
            </li>
        </ul>
    </div>

    <div class="mt-4 p-3 rounded text-center bg-body-tertiary">
        <span class="fs-3">
            A boring grammar is easier to
            <strong>learn, parse, debug, and extend.</strong>
        </span>
    </div>
</section>