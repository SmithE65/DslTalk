@model SlideViewModel

@{
    ViewData["Title"] = "Calculator";
}

<section class="demo-slide calculator-demo">
    <header class="demo-header">
        <div>
            <h1>A Basic Calculator</h1>
            <p class="slide-subtitle">
                Scan → Parse → Interpret Expressions
            </p>
        </div>
    </header>

    <div class="calculator-summary">
        <div class="expression-panel">
            <label for="expressionInput">Expression</label>

            <div class="expression-entry">
                <input id="expressionInput"
                       class="expression-input"
                       type="text"
                       value="(1 + 2) / 3 * 6"
                       autocomplete="off"
                       spellcheck="false" />

                <button id="evaluateButton"
                        class="btn btn-primary"
                        type="button">
                    Evaluate
                </button>
            </div>
        </div>

        <div class="result-panel">
            <span class="panel-label">Result</span>
            <output id="resultValue" class="result-value">
                —
            </output>
        </div>
    </div>

    <section class="token-panel">
        <h2>Tokens</h2>

        <div id="tokenStream" class="token-stream">
            <span class="empty-state">Evaluate an expression</span>
        </div>
    </section>

    <section class="ast-panel">
        <div class="ast-heading">
            <h2>Abstract Syntax Tree</h2>
        </div>

        <div id="astContainer" class="ast-container">
            <div class="empty-state">Evaluate an expression</div>
        </div>
    </section>
</section>

@section Scripts {
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.16.1/+esm'

        mermaid.initialize({
            startOnLoad: false,
            theme: 'neutral'
        });

        const expressionInput = document.getElementById('expressionInput');
        const evaluateButton = document.getElementById('evaluateButton');
        const tokenStream = document.getElementById('tokenStream');
        const astContainer = document.getElementById('astContainer');
        const resultValue = document.getElementById('resultValue');

        evaluateButton.addEventListener('click', evaluate);

        expressionInput.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                evaluate();
            }
        });

        async function evaluate() {
            clearErrors();

            const response = await fetch('/api/calculator', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    dslText: expressionInput.value
                })
            });

            const model = await response.json();

            renderTokens(model);
            await renderAst(model);
            renderResult(model);
        }

        function renderTokens(model) {
            tokenStream.replaceChildren();

            if (model.diagnostic && model.diagnostic.phase === "Scanning") {
                renderError(tokenStream, model.diagnostic.message);
                return;
            }

            for (const token of model.tokens) {
                const element = document.createElement('span');
                element.className = 'token';
                element.textContent = token.lexeme;

                element.title =
                    `Type: ${token.type}\n` +
                    `Lexeme: ${token.lexeme}` +
                    (token.value != null ? `\nValue: ${token.value}` : '') +
                    (token.position != null ? `\nPosition: ${token.position}` : '');

                tokenStream.appendChild(element);
            }
        }

        async function renderAst(model) {
            astContainer.replaceChildren();

            if (model.parserError) {
                renderError(astContainer, model.parserError);
                return;
            }

            if (!model.ast) {
                return;
            }

            const diagram = document.createElement('div');
            diagram.className = 'mermaid';
            diagram.textContent = astToMermaid(model.ast);

            astContainer.appendChild(diagram);

            await mermaid.run({
                nodes: [diagram]
            });
        }

        function renderResult(model) {
            if (model.runtimeError) {
                resultValue.textContent = model.runtimeError;
                resultValue.classList.add('result-error');
                return;
            }

            resultValue.textContent = model.resultText ?? '—';
        }

        function renderError(container, message) {
            const error = document.createElement('div');
            error.className = 'demo-error';
            error.textContent = message;

            container.appendChild(error);
        }

        function clearErrors() {
            resultValue.classList.remove('result-error');
        }

        function astToMermaid(root) {
            if (!root) {
                return "";
            }

            const lines = [
                "flowchart LR"
            ];

            let nextId = 0;

            function visit(node) {
                const id = `n${nextId++}`;

                lines.push(`    ${id}["${escapeMermaidLabel(formatNode(node))}"]`);

                for (const child of node.children ?? []) {
                    if (!child) {
                        continue;
                    }

                    const childId = visit(child);
                    lines.push(`    ${id} --> ${childId}`);
                }

                return id;
            }

            visit(root);

            return lines.join("\n");
        }

        function formatNode(node) {
            const parts = [];

            if (node.kind) {
                parts.push(node.kind);
            }

            if (node.label) {
                parts.push(node.label);
            }

            for (const property of node.properties ?? []) {
                const value = property.value ?? "null";
                parts.push(`${property.name}: ${value}`);
            }

            return parts.join("\n");
        }

        function escapeMermaidLabel(value) {
            return String(value)
                .replaceAll("&", "&amp;")
                .replaceAll('"', "&quot;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;");
        }

        // Initial render.
        evaluate();
    </script>
}