@model SlideViewModel

<section class="slide-section">
    <header>
        <h1>A Calculator Language</h1>
        <p class="slide-subtitle">
            Before we can calculate it, we have to decide what it means.
        </p>
    </header>

    <div class="demo-panel p-4 my-4">
        <div class="row align-items-center g-4">
            <div class="col-5 text-center">
                <div class="demo-panel-label">Source</div>
                <div class="font-monospace fs-1 fw-semibold">
                    (1 + 2) * 3 / -4
                </div>
            </div>

            <div class="col-7">
                <blockquote class="mb-0 fs-4 fst-italic opacity-75">
                    “Math is a language; do what it says.”
                    <span class="d-block fs-6 mt-1">
                        — my high school math teacher
                    </span>
                </blockquote>
            </div>
        </div>
    </div>

    <div class="row g-5 flex-grow-1 align-items-center">
        <div class="col-6">
            <h2>Vocabulary</h2>

            <ul class="slide-bullets">
                <li>What are our <strong>words</strong>?</li>
                <li>What are our parts of speech?</li>
                <li>What counts as <strong>punctuation</strong>?</li>
                <li>Is <code>-</code> subtraction, negation, or both?</li>
            </ul>
        </div>

        <div class="col-6">
            <h2>Grammar</h2>

            <ul class="slide-bullets">
                <li>Is <strong>4 + -3</strong> valid?</li>
                <li>
                    What about <strong>4+-3</strong>?
                    <strong>+4+-3</strong>?
                </li>
                <li>Which operations bind first?</li>
                <li>How does grouping change the structure?</li>
            </ul>
        </div>
    </div>

    <div class="mt-3">
        <div class="row row-cols-3 g-3 text-center">
            <div class="col">
                <div class="bg-body-tertiary rounded p-2 font-monospace fs-4">
                    (1 + 2) * 3
                </div>
            </div>

            <div class="col">
                <div class="bg-body-tertiary rounded p-2 font-monospace fs-4">
                    1 + (2 * 3)
                </div>
            </div>

            <div class="col">
                <div class="bg-body-tertiary rounded p-2 font-monospace fs-4">
                    1 + 2 * 3
                </div>
            </div>
        </div>

        <p class="slide-subtitle text-center mt-2">
            Same vocabulary. Different structure.
        </p>
    </div>
</section>