@model SlideViewModel

<section class="bullet-slide reinvent-slide">
    <h1>We Really Like Reinventing...</h1>

    <div class="reinvent-grid">
        <div class="reinvent-item">
            <h2>Templates</h2>
            <p>
                <code>{Name}</code> → defaults → conditionals → loops
            </p>
        </div>

        <div class="reinvent-item">
            <h2>Expressions &amp; Formulas</h2>
            <p>
                <code>subtotal + tax</code> → precedence → types → functions
            </p>
        </div>

        <div class="reinvent-item">
            <h2>Wildcards &amp; String Matching</h2>
            <p>
                <code>ABC*</code> → exclusions → grouping → regex, but worse
            </p>
        </div>

        <div class="reinvent-item">
            <h2>Query &amp; Filter Syntax</h2>
            <p>
                <code>status:open total&gt;500</code> → AND / OR → grouping
            </p>
        </div>

        <div class="reinvent-item">
            <h2>Object &amp; Path Expressions</h2>
            <p>
                <code>Customer.Address.City</code> → arrays → filters → JSONPath
            </p>
        </div>

        <div class="reinvent-item">
            <h2>Scheduling Rules</h2>
            <p>
                Every weekday at 8 → exceptions → recurrence rules
            </p>
        </div>
    </div>

    <div class="reinvent-callout">
        Before designing syntax, ask:
        <strong>Does this language already exist?</strong>
    </div>
</section>